# We include setups for
#	OSGi-Test Support - gecko-osgitest
#	DIMC Github-Configuration - gecko-dimc
#	Jacoco Support - gecko-jacoco
-library: \
	geckoDIMC,\
	geckoBndEclipse
	
# Needed because we enabled library 'gecko-dimc'
# Activate baselining
dimcBaselining: true
github-project: org.eclipse.fennec.emf.editors
github-group: eclipse-fennec
base-version: 1.0.0

# Maven Central Group-Id
# For Geckoprojects the groupid must start with org.geckoprojects
-groupid: org.geckoprojects.emf.editors

-require-bnd "(version>=6.3.1)"

-jpms-module-info:

-plugin.2.Central: aQute.bnd.repository.maven.provider.MavenBndRepository;\
		snapshotUrl         ='https://central.sonatype.com/repository/maven-snapshots/';\
		releaseUrl          ='https://repo.maven.apache.org/maven2/';\
		index               ='${.}/central.mvn';\
		readOnly            =true;\
		'poll.time'         =-1;\
		name                =Central

-plugin.eclipse.2019.09: \
        aQute.bnd.repository.osgi.OSGiRepository;\
        name=Eclipse_2019.09;\
        locations=https://devel.data-in-motion.biz/repository/eclipse-2019-09/plugins/index.xml

-plugin.p2: aQute.p2.export.P2Exporter