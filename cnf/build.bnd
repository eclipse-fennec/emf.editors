# We include setups for
#	OSGi-Test Support - gecko-osgitest
#	DIMC Github-Configuration - gecko-dimc
#	Jacoco Support - gecko-jacoco
-library: \
	geckoDIMC
	
# Needed because we enabled library 'gecko-dimc'
# Activate baselining
dimcBaselining: true
github-project: org.eclipse.fennec.emf.editors
github-group: eclipse-fennec
base-version: 1.0.0

# Maven Central Group-Id
# For Geckoprojects the groupid must start with org.geckoprojects
-groupid: org.geckoprojects.emf.editors

-require-bnd "(version>=6.3.1)"

-jpms-module-info:

-plugin.2.Central: aQute.bnd.repository.maven.provider.MavenBndRepository;\
		snapshotUrl         ='https://central.sonatype.com/repository/maven-snapshots/';\
		releaseUrl          ='https://repo.maven.apache.org/maven2/';\
		index               ='${.}/central.mvn';\
		readOnly            =true;\
		'poll.time'         =-1;\
		name                =Central

# Content of the Gecko bnd Eclipse library 2.0.0-SNAPSHOT (formerly -library geckoBndEclipse),
# inlined: the library's template lists a further, non-Central snapshot repository first;
# here snapshots come from the Central snapshot repository only.
# Index files copied from the library: cnf/eclipse-rcp.mvn, cnf/bnd-eclipse.mvn.
# Curated Eclipse 4.41 (2026-09) RCP platform from Maven Central.
-plugin.bnd-Eclipse:\
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/eclipse-rcp.mvn; \
		readOnly=true; \
		poll.time=-1;\
		name="Eclipse 4.41 RCP"

-plugin.bnd.eclipse.central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		snapshotUrl=https://central.sonatype.com/repository/maven-snapshots/; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/bnd-eclipse.mvn; \
		readOnly=true; \
		poll.time=-1;\
		name="Bnd Eclipse Central"

# EMF UI bundles (org.eclipse.emf.common.ui, .edit.ui, .ecore.editor) are not on Maven
# Central: EMF 2.47.0 release update site, the EMF release matching Eclipse 4.41.
-plugin.emf.p2: \
	aQute.bnd.repository.p2.provider.P2Repository;\
		name="EMF 2.47.0";\
		url="https://download.eclipse.org/modeling/emf/emf/builds/release/2.47.0";\
		poll.time=-1

-plugin.p2: aQute.p2.export.P2Exporter