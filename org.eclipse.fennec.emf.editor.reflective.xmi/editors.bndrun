Bundle-Name: Eclipse Fennec EMF Editors
Bundle-SymbolicName: org.eclipse.fennec.emf.editors
Bundle-Vendor: Eclipse Foundation
Bundle-Version  1.0.0
Bundle-License:  \
    EPL-2.0;\
        description="This program and the accompanying materials are made available under the terms of the Eclipse License, Version 2.0";\
        link="https://opensource.org/licenses/EPL-2.0"
Bundle-Category: editors

-runfw: org.eclipse.osgi;version='[3.24.300,3.24.301)'
-runee: JavaSE-21
-runbundles: org.eclipse.fennec.emf.editor.reflective.xmi;version=snapshot

-runrequires: bnd.identity;id='org.eclipse.fennec.emf.editor.reflective.xmi'

# SBOM for `./gradlew sbom`: this feature is the content of the p2 update site
# (p2updatesite.bndrun only references it). The exporter is included only once it has been
# fetched (see cnf/sbom/plugin.bnd); resolve, launch and the p2 export ignore both lines.
-include: ${if;${isfile;${workspace}/cnf/cache/sbom-exporter/org.gecko.bnd.sbom.jar};${workspace}/cnf/sbom/plugin.bnd}
-sbom: level=medium, format=cyclonedx
